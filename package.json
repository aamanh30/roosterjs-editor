{
  "name": "roosterjs-editor",
  "version": "1.0.0",
  "description": "A lightweight, framework-agnostic RoosterJS wrapper for Angular, React, Vue, Svelte, and plain JS.",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepare": "npm run build",
    "typecheck:test": "tsc -p tsconfig.spec.json --noEmit",
    "test": "npm run typecheck:test && vitest -c vitest.config.ts --tsconfig tsconfig.spec.json",
    "test:watch": "vitest -c vitest.config.ts --tsconfig tsconfig.spec.json --watch",
    "storybook": "storybook dev",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "roosterjs",
    "angular",
    "react",
    "vue",
    "svelte",
    "web-components",
    "rich-text-editor"
  ],
  "dependencies": {
    "lit": "^3.3.1",
    "roosterjs": "^9.39.0"
  },
  "devDependencies": {
    "@open-wc/testing": "^3.0.0",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/web-components": "^10.5.8",
    "@storybook/web-components-vite": "^10.5.8",
    "@types/jsdom": "^27.0.0",
    "jsdom": "^27.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "type": "module",
  "author": "aamanh30",
  "license": "MIT"
}
